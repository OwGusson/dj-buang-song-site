VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Cloudflare Functions runtime also needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
# Set SUPABASE_SERVICE_ROLE_KEY and INTERACTION_HASH_SECRET only as server secrets.

# Cloudflare server configuration for the private conversation service.
# Keep CONTACTS_ENABLED=false until SMTP, auth CAPTCHA, templates, policies and deployment are ready.
CONTACTS_ENABLED=false
AUTH_CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY
# Server-only secrets: TURNSTILE_SECRET_KEY and RESEND_API_KEY. Never prefix these with VITE_.
CONTACT_EMAIL_FROM=DJ-Buang <no-reply@mail.dj-buang.com>
SUPPORT_ENABLED=false
GLOBAL_BARANGAY_RELEASED=false
